generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  concept2Id     Int       @unique @map("concept2_id")
  email          String?
  displayName    String?   @map("display_name")
  accessToken    String    @map("access_token")
  refreshToken   String    @map("refresh_token")
  tokenExpiresAt DateTime  @map("token_expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  workouts      Workout[]
  personalBests PersonalBest[]
  trendReports  TrendReport[]

  @@map("users")
}

model Workout {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  concept2ResultId      Int       @unique @map("concept2_result_id")
  workoutDate           DateTime  @map("workout_date")
  workoutType           String    @map("workout_type")
  description           String?
  distanceMeters        Int?      @map("distance_meters")
  durationSeconds       Int?      @map("duration_seconds")
  avgSplitSeconds       Decimal?  @map("avg_split_seconds") @db.Decimal(10, 2)
  avgSpm                Decimal?  @map("avg_spm") @db.Decimal(10, 2)
  avgWatts              Decimal?  @map("avg_watts") @db.Decimal(10, 2)
  totalCalories         Int?      @map("total_calories")
  heartRateAvg          Int?      @map("heart_rate_avg")
  heartRateMax          Int?      @map("heart_rate_max")
  rawCsvPath            String?   @map("raw_csv_path")
  strokeDataParsed      Boolean   @default(false) @map("stroke_data_parsed")
  aiAnalysisId          String?   @map("ai_analysis_id") @db.Uuid

  driveToRecoveryRatio  Decimal?  @map("drive_to_recovery_ratio") @db.Decimal(10, 4)
  paceConsistencyStddev Decimal?  @map("pace_consistency_stddev") @db.Decimal(10, 4)
  powerConsistencyStddev Decimal? @map("power_consistency_stddev") @db.Decimal(10, 4)
  spmConsistencyStddev  Decimal?  @map("spm_consistency_stddev") @db.Decimal(10, 4)
  powerCurveJson        Json?     @map("power_curve_json")
  paceCurveJson         Json?     @map("pace_curve_json")
  firstQuarterAvgWatts  Decimal?  @map("first_quarter_avg_watts") @db.Decimal(10, 2)
  lastQuarterAvgWatts   Decimal?  @map("last_quarter_avg_watts") @db.Decimal(10, 2)
  peakPowerWatts        Decimal?  @map("peak_power_watts") @db.Decimal(10, 2)
  peakPowerStrokeNumber Int?      @map("peak_power_stroke_number")

  createdAt             DateTime  @default(now()) @map("created_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  strokeData    StrokeDataPoint[]
  aiAnalysis    AiAnalysis?
  personalBests PersonalBest[]

  @@index([userId, workoutDate])
  @@index([workoutType])
  @@map("workouts")
}

model StrokeDataPoint {
  id                  String   @id @default(uuid()) @db.Uuid
  workoutId           String   @map("workout_id") @db.Uuid
  strokeNumber        Int      @map("stroke_number")
  elapsedTimeMs       Int?     @map("elapsed_time_ms")
  strokeRate          Decimal? @map("stroke_rate") @db.Decimal(10, 2)
  paceSplitSecs       Decimal? @map("pace_split_secs") @db.Decimal(10, 2)
  powerWatts          Decimal? @map("power_watts") @db.Decimal(10, 2)
  driveLengthM        Decimal? @map("drive_length_m") @db.Decimal(10, 4)
  driveTimeSecs       Decimal? @map("drive_time_secs") @db.Decimal(10, 4)
  strokeDistanceM     Decimal? @map("stroke_distance_m") @db.Decimal(10, 4)
  cumulativeDistanceM Decimal? @map("cumulative_distance_m") @db.Decimal(10, 2)
  heartRate           Int?     @map("heart_rate")
  createdAt           DateTime @default(now()) @map("created_at")

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId, strokeNumber])
  @@map("stroke_data_points")
}

model AiAnalysis {
  id            String   @id @default(uuid()) @db.Uuid
  workoutId     String   @unique @map("workout_id") @db.Uuid
  modelVersion  String   @map("model_version")
  analysisJson  Json     @map("analysis_json")
  narrativeText String?  @map("narrative_text")
  generatedAt   DateTime @default(now()) @map("generated_at")

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}

model PersonalBest {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  category   String
  value      Decimal  @db.Decimal(12, 2)
  workoutId  String   @map("workout_id") @db.Uuid
  achievedAt DateTime @map("achieved_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("personal_bests")
}

model TrendReport {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")
  reportJson   Json     @map("report_json")
  narrativeText String? @map("narrative_text")
  generatedAt  DateTime @default(now()) @map("generated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@map("trend_reports")
}

model JobFailure {
  id        String   @id @default(uuid()) @db.Uuid
  queueName String   @map("queue_name")
  jobId     String   @map("job_id")
  error     String
  payload   Json?
  failedAt  DateTime @default(now()) @map("failed_at")

  @@map("job_failures")
}
