# Concept2 OAuth - Register at https://log.concept2.com/developers
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=
CONCEPT2_REDIRECT_URI=http://localhost:3000/api/auth/concept2/callback

# Anthropic Claude API
ANTHROPIC_API_KEY=

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/concept2_rowing

# Redis (for BullMQ job queues)
REDIS_URL=redis://localhost:6379

# NextAuth.js
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# S3-compatible Storage for CSV files
STORAGE_BUCKET=concept2-stroke-data
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# AES-256 encryption key for OAuth tokens (64 hex chars = 32 bytes)
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
